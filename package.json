{
  "name": "ai-club-season-26-27",
  "version": "1.0.0",
  "description": "A home for the SFEIR Luxembourg AI Club programme from **October 2026 through June 2027**, with three parallel tracks: **Foundations (Beginner)**, **Engineering (Practitioner)**, and **Deep Dive (Advanced)**.",
  "scripts": {
    "dev": "npm run content:validate && vite --host 127.0.0.1",
    "content:validate": "node --import tsx scripts/validate-content.ts",
    "typecheck": "npm run content:validate && tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run tests/content.test.ts",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GadDev/ai-club-season-26-27-live.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/GadDev/ai-club-season-26-27-live/issues"
  },
  "homepage": "https://github.com/GadDev/ai-club-season-26-27-live#readme",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/league-gothic": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "15.32.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
